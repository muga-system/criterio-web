---
import { ChevronDown, ChevronUp } from "@lucide/astro";

interface Props {
  class?: string;
  id: string;
  label: string;
  viewportClass?: string;
}

const { class: className = "", id, label, viewportClass = "" } = Astro.props;
---

<div class:list={["app-scroll-frame", className]} data-scroll-frame>
  <div
    class:list={["app-scroll-viewport", viewportClass]}
    data-scroll-viewport
    id={id}
    tabindex="0"
  >
    <slot />
  </div>
  <div
    aria-label={`Control de desplazamiento: ${label}`}
    class="app-scrollbar-region"
    role="region"
  >
    <div class="app-scrollbar" data-scrollbar>
      <button
        aria-controls={id}
        aria-label={`Desplazar ${label} hacia arriba`}
        data-scroll-step="-1"
        type="button"
      >
        <ChevronUp aria-hidden="true" class="app-scroll-icon" />
      </button>
      <div
        aria-controls={id}
        aria-label={label}
        aria-orientation="vertical"
        aria-valuemax="0"
        aria-valuemin="0"
        aria-valuenow="0"
        class="app-scroll-track"
        data-scroll-track
        role="scrollbar"
        tabindex="0"
      >
        <span class="app-scroll-thumb" data-scroll-thumb></span>
      </div>
      <button
        aria-controls={id}
        aria-label={`Desplazar ${label} hacia abajo`}
        data-scroll-step="1"
        type="button"
      >
        <ChevronDown aria-hidden="true" class="app-scroll-icon" />
      </button>
    </div>
  </div>
</div>

<script>
  const scrollFrames = document.querySelectorAll<HTMLElement>("[data-scroll-frame]");

  scrollFrames.forEach((frame): void => {
    const viewport = frame.querySelector<HTMLElement>("[data-scroll-viewport]");
    const scrollbar = frame.querySelector<HTMLElement>("[data-scrollbar]");
    const track = frame.querySelector<HTMLElement>("[data-scroll-track]");
    const thumb = frame.querySelector<HTMLElement>("[data-scroll-thumb]");

    if (viewport === null || scrollbar === null || track === null || thumb === null) {
      return;
    }

    const buttons = scrollbar.querySelectorAll<HTMLButtonElement>("[data-scroll-step]");

    const getMaxScroll = (): number => Math.max(0, viewport.scrollHeight - viewport.clientHeight);

    const getScrollBehavior = (): ScrollBehavior =>
      window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth";

    const render = (): void => {
      const maxScroll = getMaxScroll();
      frame.dataset.scrollable = String(maxScroll > 0);
      const trackHeight = track.clientHeight;
      const thumbHeight = Math.max(
        2.5 * parseFloat(getComputedStyle(document.documentElement).fontSize),
        trackHeight * (viewport.clientHeight / Math.max(viewport.scrollHeight, 1)),
      );
      const availableThumbSpace = Math.max(0, trackHeight - thumbHeight);
      const thumbOffset =
        maxScroll === 0 ? 0 : (viewport.scrollTop / maxScroll) * availableThumbSpace;

      thumb.style.height = `${Math.min(thumbHeight, trackHeight)}px`;
      thumb.style.transform = `translateY(${thumbOffset}px)`;
      track.setAttribute("aria-valuemax", String(maxScroll));
      track.setAttribute("aria-valuenow", String(Math.round(viewport.scrollTop)));
      buttons.forEach((button): void => {
        button.disabled = maxScroll === 0;
      });
    };

    const scrollByPage = (direction: number): void => {
      viewport.scrollBy({
        behavior: getScrollBehavior(),
        top: direction * viewport.clientHeight * 0.85,
      });
    };

    buttons.forEach((button): void => {
      button.addEventListener("click", (): void => {
        scrollByPage(Number(button.dataset.scrollStep ?? "0"));
      });
    });

    track.addEventListener("pointerdown", (event: PointerEvent): void => {
      if (event.target === thumb) {
        return;
      }

      const maxScroll = getMaxScroll();
      const trackBounds = track.getBoundingClientRect();
      const thumbHeight = thumb.offsetHeight;
      const availableThumbSpace = Math.max(0, track.clientHeight - thumbHeight);
      const targetOffset = Math.max(
        0,
        Math.min(availableThumbSpace, event.clientY - trackBounds.top - thumbHeight / 2),
      );

      if (maxScroll > 0 && availableThumbSpace > 0) {
        viewport.scrollTop = (targetOffset / availableThumbSpace) * maxScroll;
      }
    });

    thumb.addEventListener("pointerdown", (event: PointerEvent): void => {
      event.preventDefault();
      thumb.setPointerCapture(event.pointerId);

      const startY = event.clientY;
      const startScrollTop = viewport.scrollTop;
      const availableThumbSpace = Math.max(0, track.clientHeight - thumb.offsetHeight);
      const maxScroll = getMaxScroll();

      const handlePointerMove = (moveEvent: PointerEvent): void => {
        if (availableThumbSpace === 0 || maxScroll === 0) {
          return;
        }

        viewport.scrollTop =
          startScrollTop + ((moveEvent.clientY - startY) / availableThumbSpace) * maxScroll;
      };

      const handlePointerUp = (): void => {
        thumb.removeEventListener("pointermove", handlePointerMove);
        thumb.removeEventListener("pointerup", handlePointerUp);
        thumb.removeEventListener("pointercancel", handlePointerUp);
      };

      thumb.addEventListener("pointermove", handlePointerMove);
      thumb.addEventListener("pointerup", handlePointerUp);
      thumb.addEventListener("pointercancel", handlePointerUp);
    });

    track.addEventListener("keydown", (event: KeyboardEvent): void => {
      const page = viewport.clientHeight * 0.85;

      if (event.key === "ArrowUp") {
        event.preventDefault();
        viewport.scrollBy({ behavior: getScrollBehavior(), top: -viewport.clientHeight * 0.15 });
      }

      if (event.key === "ArrowDown") {
        event.preventDefault();
        viewport.scrollBy({ behavior: getScrollBehavior(), top: viewport.clientHeight * 0.15 });
      }

      if (event.key === "PageUp") {
        event.preventDefault();
        viewport.scrollBy({ behavior: getScrollBehavior(), top: -page });
      }

      if (event.key === "PageDown") {
        event.preventDefault();
        viewport.scrollBy({ behavior: getScrollBehavior(), top: page });
      }

      if (event.key === "Home") {
        event.preventDefault();
        viewport.scrollTo({ behavior: getScrollBehavior(), top: 0 });
      }

      if (event.key === "End") {
        event.preventDefault();
        viewport.scrollTo({ behavior: getScrollBehavior(), top: getMaxScroll() });
      }
    });

    scrollbar.addEventListener(
      "wheel",
      (event: WheelEvent): void => {
        event.preventDefault();
        viewport.scrollBy({ top: event.deltaY });
      },
      { passive: false },
    );

    viewport.addEventListener("scroll", render, { passive: true });
    window.addEventListener("resize", render);
    new ResizeObserver(render).observe(viewport);
    new MutationObserver(render).observe(viewport, {
      characterData: true,
      childList: true,
      subtree: true,
    });
    requestAnimationFrame(render);
  });
</script>
