---
import type { ModuleSummary } from "../app/modules/module-catalog";

interface Props {
  module: ModuleSummary;
}

const { module } = Astro.props;
const practiceLabels = {
  external: "Práctica fuera de la app",
  interactive: "Práctica interactiva",
} as const;
---

<article class="app-module-card cw-panel p-4" data-practice-tracking={module.practiceTracking}>
  <div class="app-module-card-visual cw-media mb-4">
    <img src={module.image} alt={module.imageAlt} loading="lazy" decoding="async" />
  </div>
  <div class="app-module-card-header">
    <p class="app-module-card-status">{module.status}</p>
    <p class="app-module-card-index">{module.id}</p>
  </div>
  <h2>{module.title}</h2>
  <p>{module.summary}</p>
  <div class="app-module-card-footer">
    <div class="app-module-card-meta">
      <span>{module.lessonCount} lecciones</span>
      <span>{practiceLabels[module.practiceTracking]}</span>
    </div>
    <a href={module.path} aria-label={`Abrir ${module.title}`}>
      Abrir módulo <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
