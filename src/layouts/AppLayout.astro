---
import { appRoutes, type AppRoute } from "../app/navigation/routes";
import CustomScrollbar from "../components/CustomScrollbar.astro";
import "../styles/base.css";
import "../styles/layers.css";
import "../styles/reset.css";
import "../styles/tailwind.css";
import "../styles/tokens.css";

interface Props {
  route: AppRoute;
  showWorkspaceHeader?: boolean;
}

const { route, showWorkspaceHeader = true } = Astro.props;
const currentPath = Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/$/, "");
const activeNavigationPath = currentPath.startsWith("/modulos/") ? "/modulos" : currentPath;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={route.description} />
    <title>{route.title} · Criterio Web</title>
  </head>
  <body>
    <div class="app-shell">
      <a class="app-skip-link" href="#workspace-content">Saltar al contenido principal</a>
      <header class="app-topbar">
        <a class="app-brand" href="/">
          <span class="app-brand-mark" aria-hidden="true">CW</span>
          <span>Criterio Web</span>
        </a>
        <p class="app-topbar-context">
          <span><small>mundo</small> local</span><span><small>fase</small> 01</span>
        </p>
      </header>
      <div class="app-layout">
        <CustomScrollbar
          id="sidebar-scroll-viewport"
          label="Navegación principal"
          class="app-sidebar-frame"
        >
          <aside class="app-sidebar">
            <div>
              <p class="app-sidebar-label">Mapa de aprendizaje</p>
              <nav aria-label="Navegación principal">
                <ul class="app-nav-list">
                  {
                    appRoutes.map((navigationRoute, index) => {
                      const isActive = navigationRoute.path === activeNavigationPath;

                      return (
                        <li>
                          <a
                            class:list={["app-nav-link", { "is-active": isActive }]}
                            href={navigationRoute.path}
                            aria-current={isActive ? "page" : undefined}
                          >
                            <span class="app-nav-index" aria-hidden="true">
                              {String(index + 1).padStart(2, "0")}
                            </span>
                            <span>{navigationRoute.label}</span>
                          </a>
                        </li>
                      );
                    })
                  }
                </ul>
              </nav>
            </div>
            <div class="app-sidebar-status" aria-label="Estado del sistema local">
              <span class="app-sidebar-status-label">Estado del sistema</span>
              <strong>LISTO</strong>
              <span class="app-sidebar-status-detail">Progreso local activo</span>
            </div>
          </aside>
        </CustomScrollbar>
        <CustomScrollbar
          id="workspace-scroll-viewport"
          label="Área de trabajo"
          class="app-workspace-frame"
        >
          <main
            class="app-workspace"
            id="workspace-content"
            tabindex="-1"
            aria-label={showWorkspaceHeader ? undefined : route.label}
            aria-labelledby={showWorkspaceHeader ? "workspace-title" : undefined}
          >
            {
              showWorkspaceHeader && (
                <header class="app-workspace-header">
                  <p class="app-workspace-kicker">{route.eyebrow}</p>
                  <h1 id="workspace-title">{route.title}</h1>
                  <p class="app-workspace-description">{route.description}</p>
                  <div class="app-workspace-hud" aria-hidden="true">
                    <span>SECTOR 01</span>
                    <span>RUN LOCAL</span>
                    <span class="is-ready">● LISTO</span>
                  </div>
                </header>
              )
            }
            <slot />
          </main>
        </CustomScrollbar>
      </div>
    </div>
  </body>
</html>
