---
import { appRoutes } from "../app/navigation/routes";
import { moduleCatalog } from "../app/modules/module-catalog";
import LessonProgressNavigator from "../components/LessonProgressNavigator";
import PracticeNavigator from "../components/PracticeNavigator";
import AppLayout from "./AppLayout.astro";

const route = appRoutes[1];
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const module = moduleCatalog.find((entry) => entry.path === currentPath) ?? moduleCatalog[0];
const hasInteractivePractice = module.id === "dom-eventos-06";
const requiredLessons = module.lessons.filter((lesson) => lesson.id !== "practica-integradora");
---

<AppLayout route={route} showWorkspaceHeader={false}>
  <div class="module-page">
    <a class="module-back-link" href="/modulos">← Volver a módulos</a>
    <nav class="module-contents" aria-labelledby="module-contents-title">
      <p class="app-placeholder-label">Recorrido</p>
      <h2 id="module-contents-title">En este módulo</h2>
      <ol>
        {
          module.lessons.map((lesson) => (
            <li>
              <a href={`#${lesson.id}`}>{lesson.title}</a>
            </li>
          ))
        }
      </ol>
    </nav>
    <article class="module-content">
      <slot />
    </article>
    {
      !hasInteractivePractice && (
        <LessonProgressNavigator client:load moduleId={module.id} lessons={requiredLessons} />
      )
    }
    {hasInteractivePractice && <PracticeNavigator client:load />}
  </div>
</AppLayout>
